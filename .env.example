# Only for the maintainer's release and deployment work. Local development
# and the tests need no .env file.
#
# Copy this file to .env on the maintainer's machine (.env is ignored by git)
# and fill in the values that the maintaining group's internal Cloudflare
# procedure gives. To load it into the current shell, run the following from
# the repository root, again in every new terminal:
#
#   set -a; source ./.env; set +a
#
# Each line is KEY=value with no spaces around the equals sign. Put single
# quotes around any value that contains spaces, #, $, ! or backticks.
#
# Cloudflare credentials, used by the release and deploy workflows (as
# repository secrets) and by local uploads.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# The R2 bucket of the releases, used by the release workflow from milestone 5.
R2_BUCKET=catalejo-releases
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
#
# Optional. The rclone remote and the bucket that
# `pnpm --dir packages/web run upload-assets` writes to; without them it
# uses the remote r2 and the bucket catalejo-releases.
# CATALEJO_R2_REMOTE=r2
# CATALEJO_R2_BUCKET=catalejo-releases

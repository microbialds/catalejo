{
  "name": "@catalejo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "extensions": "node scripts/fetch-duckdb-extensions.mjs",
    "predev": "pnpm run generate && pnpm run extensions",
    "dev": "vite",
    "prebuild": "pnpm run generate",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-dist.mjs",
    "prepreview": "pnpm run extensions",
    "preview": "vite preview",
    "pretest": "pnpm run generate && pnpm run extensions",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "pretypecheck": "pnpm run generate",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "apache-arrow": "17.0.0",
    "cgview": "1.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}

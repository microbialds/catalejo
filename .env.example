# Copied to .env on the maintainer's machine; .env is ignored by git.
# Cloudflare credentials are used only by the release and deploy workflows
# and by local uploads with rclone; see dev/cloudflare-setup.md.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=catalejo-releases
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
